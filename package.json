{
  "name": "pharmacy-pos",
  "version": "1.0.0",
  "description": "Standalone Pharmacy Point of Sale System",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "db:sync": "node electron/database/sync.js"
  },
  "keywords": [
    "pharmacy",
    "pos",
    "electron",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "primevue": "^3.50.0",
    "primeicons": "^6.0.1",
    "primeflex": "^3.3.1",
    "sequelize": "^6.35.0",
    "mysql2": "^3.6.5",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pharmacy.pos",
    "productName": "Pharmacy POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
