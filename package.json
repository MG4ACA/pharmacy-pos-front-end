{
  "name": "pharmacy-pos",
  "version": "1.0.0",
  "description": "Standalone Pharmacy Point of Sale System",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on tcp:5173 && electron .\"",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win --x64",
    "electron:build:portable": "npm run build && electron-builder --win portable",
    "db:sync": "node electron/database/sync.js",
    "db:seed": "node electron/database/seedDatabase.js",
    "db:create": "node -e \"import('mysql2/promise').then(m => m.default.createConnection({host:'localhost',port:3306,user:'root',password:'1234'}).then(c => c.query('CREATE DATABASE IF NOT EXISTS pharmacy_pos').then(() => {console.log('Database created');c.end();process.exit(0);})));\""
  },
  "keywords": [
    "pharmacy",
    "pos",
    "electron",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "mysql2": "^3.6.5",
    "pinia": "^2.1.7",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primevue": "^3.50.0",
    "sequelize": "^6.35.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pharmacy.pos",
    "productName": "Pharmacy POS System",
    "copyright": "Copyright © 2025",
    "electronVersion": "28.3.3",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/database/pharmacy_pos.sqlite",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/database",
        "to": "database",
        "filter": [
          "*.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publisherName": "Pharmacy POS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pharmacy POS",
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png",
      "installerHeaderIcon": "build/icon.png",
      "license": "LICENSE.txt"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
